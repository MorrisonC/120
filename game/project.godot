; Engine configuration file.
config_version=5

[application]
config/name="Procedural Time-Loop"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]
TelemetryLogger="*res://TelemetryLogger.gd"
TimeManager="*res://TimeManager.gd"
GameState="*res://GameState.gd"
NetworkStateDispatcher="*res://NetworkStateDispatcher.gd"
VisualJuiceManager="*res://VisualJuiceManager.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

